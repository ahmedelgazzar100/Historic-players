{
  "version": 2,
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "server/src/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "server/index.js" },
    { "src": "/login", "dest": "server/src/index.js" },
    { "src": "/register", "dest": "server/src/index.js" },
    { "src": "/auth/(.*)", "dest": "server/src/index.js" },
    { "src": "/(.*\\..*)", "dest": "/client/$1" },
    { "src": "/(.*)", "dest": "/client/index.html" }
  ]
}
